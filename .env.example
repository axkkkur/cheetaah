GEMINI_API_KEY=
CHEETAAH_TOKEN=            # long random string; phone sends it as X-Token header
CHEETAAH_REPO=             # absolute path of the target git repo changes are applied to
CHEETAAH_DATA=./data
GEMINI_MODEL=gemini-3.8-flash
# If 3.8-flash is unavailable on free tier, use: gemini-2.5-flash
CHEETAAH_TEST_CMD=         # optional, e.g. "pytest -q"
AGENT_BIN=agy              # Antigravity CLI for Approve & run
AGENT_TIMEOUT=600
AGY_MODEL=                 # optional; leave empty for CLI default
